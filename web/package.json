{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:complete": "vitest run && playwright test",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mts",
    "db:demo": "node --env-file-if-exists=.env prisma/demo.mts",
    "admin:criar": "node --env-file-if-exists=.env prisma/criar-admin.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-email/render": "^1.4.0",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "mapbox-gl": "^3.34.1",
    "next": "16.2.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hot-toast": "^2.5.2",
    "resend": "6.3.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.16",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.18.0",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.3.4"
  }
}
